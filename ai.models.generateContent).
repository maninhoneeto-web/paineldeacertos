import express, { Request, Response } from 'express';
import dotenv from 'dotenv';
import path from 'path';
import { fileURLToPath } from 'url';
import { GoogleGenAI, Type } from '@google/genai';

dotenv.config();

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = process.env.PORT || 3000;

// Handle JSON payloads up to 50MB for receipt photo transfers
app.use(express.json({ limit: '50mb' }));
app.use(express.urlencoded({ limit: '50mb', extended: true }));

// Initialize Gemini SDK with User-Agent header as required
const apiKey = process.env.GEMINI_API_KEY || '';
const ai = new GoogleGenAI({
  apiKey,
  httpOptions: {
    headers: {
      'User-Agent': 'aistudio-build',
    },
  },
});

// Endpoint: Receipt OCR & Financial extraction using Gemini
app.post('/api/gemini/extract-receipt', async (req: Request, res: Response) => {
  try {
    const { imageBase64, mimeType = 'image/jpeg', knownPersons = [], currentPerson = '' } = req.body;

    if (!imageBase64) {
      return res.status(400).json({
        success: false,
        error: 'Nenhuma imagem foi enviada para processamento.',
      });
    }

    if (!apiKey) {
      return res.status(500).json({
        success: false,
        error: 'A chave da API Gemini (GEMINI_API_KEY) não está configurada no ambiente.',
      });
    }

    // Strip data URL scheme prefix if present and detect mimeType
    let cleanBase64 = imageBase64;
    let detectedMime = mimeType || 'image/jpeg';
    const matchMime = imageBase64.match(/^data:([^;]+);base64,/);
    if (matchMime) {
      detectedMime = matchMime[1];
      cleanBase64 = imageBase64.replace(/^data:[^;]+;base64,/, '');
    }

    const systemPrompt = `Você é o melhor contador e auditor financeiro especialista em acertos de obras, cadernos financeiros, propostas comerciais e orçamentos do Brasil.
Sua especialidade é transcrever fielmente fotos de cadernos de obras manuscritos, folhas de acertos, recibos, propostas e notas fiscais, TRANSFORMANDO CADA LINHA ESCRITA NA FOTO EM UM ITEM DE UMA TABELA CONTÁBIL.

MISSÃO CRÍTICA E OBRIGATÓRIA:
TRANSFORMAR TUDO O QUE ESTIVER ESCRITO NA FOTO EM UMA TABELA COMPLETA DE ITENS, DESCRIÇÕES E VALORES!
NÃO RESUMA, NÃO OMITA, NÃO AGRUPE!
Se a foto tiver 5, 10, 20 ou 50 itens/anotações na folha, EXTRAIA CADA UMA DELAS PARA A LISTA 'linhas'!

1. EXTRAÇÃO DE ITENS E VALORES:
   - 'descricao': nome do item, produto, equipamento, serviço, vale ou despesa como escrito na foto (ex: "Câmera Bullet", "Cabo de rede", "Conector BNC", "Almoço", "Gasolina", "Vale Neto", "Diária ajudante", "Fonte 12V", "Cimento").
   - 'valorCentavos': número inteiro em centavos de Real.
     * Ex: 10 => 1000 (R$ 10,00)
     * Ex: 50 => 5000 (R$ 50,00)
     * Ex: 150,00 => 15000 (R$ 150,00)
     * Ex: 601 => 60100 (R$ 601,00)
     * Ex: 1.200,00 => 120000 (R$ 1.200,00)
   - 'quantidade': quantidade numérica se indicada (ex: 4 câmeras => quantidade: 4; padrão: 1).
   - 'valorOriginalTexto': o texto exato do valor como visto na imagem (ex: "R$ 150,00", "50", "601").

2. CLASSIFICAÇÃO RIGOROSA ('tipoSugerido'):
   - 'adiantamento': OBRIGATÓRIO para qualquer item que represente VALE, ADIANTAMENTO, RETIRADA, 'PEGOU', 'ADIANTADO', 'VALE PIX', 'VALE EM DINHEIRO'.
   - 'saida': OBRIGATÓRIO para despesas operacionais da obra (almoço, café, gasolina, diária de mão de obra, pedágio, transporte).
   - 'material': OBRIGATÓRIO para compras de equipamentos, cabos, câmeras, conectores, fontes, dvr, ferramentas, parafusos, tubulações e materiais de instalação.
   - 'entrada': OBRIGATÓRIO para valores recebidos (adiantamento do cliente, sinal, medições, pagamentos recebidos).
   - 'divida': para contas pendentes ou fiados.

3. RECONHECIMENTO DE PESSOAS E COLUNAS:
   - Se o caderno estiver organizado em colunas ou blocos separados por pessoa (ex: bloco do "Neto", bloco do "Victor"), atribua 'pessoaSugerida' para CADA item com o nome da respectiva pessoa!
   - Identifique todas as pessoas encontradas e liste em 'todasPessoasIdentificadas'.
   - Pessoas conhecidas: ${knownPersons.join(', ') || 'Neto, Victor'}.

4. TOTAIS E CÁLCULOS:
   - Se houver somatório escrito na folha, informe em 'totalEscritoNaAnotacaoCentavos'.`;

    const imagePart = {
      inlineData: {
        mimeType: detectedMime,
        data: cleanBase64,
      },
    };

    const textPart = {
      text: `Transcreva cuidadosamente tudo o que estiver escrito nesta foto de folha de acerto/caderno. Transforme cada anotação em uma linha da tabela com descrição exata, valor correto em centavos, tipo (saida, adiantamento, material, entrada) e pessoa correspondente.`,
    };

    const schemaConfig = {
      type: Type.OBJECT,
      properties: {
        tipoDocumento: {
          type: Type.STRING,
          description: 'Tipo do documento (ex: Folha de Caderno de Acerto, Comprovante Pix, Cupom Fiscal, Recibo Manuscrito, etc.)',
        },
        tituloSugeridoAcerto: {
          type: Type.STRING,
          description: 'Título sugerido para o acerto identificado na folha',
        },
        todasPessoasIdentificadas: {
          type: Type.ARRAY,
          description: 'Lista com o nome de todas as pessoas, funcionários ou parceiros encontrados na folha',
          items: { type: Type.STRING },
        },
        totalEscritoNaAnotacaoCentavos: {
          type: Type.NUMBER,
          description: 'Total geral escrito explicitamente no documento em centavos (ou 0 se não houver soma explícita)',
        },
        totalEscritoFormatado: {
          type: Type.STRING,
          description: 'Texto exato do total escrito (ex: "R$ 450,00")',
        },
        estabelecimentoOuLoja: {
          type: Type.STRING,
          description: 'Nome da loja, banco ou estabelecimento identificado',
        },
        dataGeral: {
          type: Type.STRING,
          description: 'Data geral do documento no formato YYYY-MM-DD',
        },
        observacoes: {
          type: Type.STRING,
          description: 'Observações, avisos de rasura ou resumo da leitura contábil',
        },
        linhas: {
          type: Type.ARRAY,
          description: 'Lista de todos os lançamentos ou itens extraídos da imagem',
          items: {
            type: Type.OBJECT,
            properties: {
              data: {
                type: Type.STRING,
                description: 'Data do item no formato YYYY-MM-DD',
              },
              descricao: {
                type: Type.STRING,
                description: 'Descrição detalhada do item ou transação',
              },
              quantidade: {
                type: Type.NUMBER,
                description: 'Quantidade (padrão 1 se não especificado)',
              },
              valorUnitarioCentavos: {
                type: Type.NUMBER,
                description: 'Valor unitário em centavos',
              },
              valorCentavos: {
                type: Type.NUMBER,
                description: 'Valor total da linha em centavos',
              },
              valorOriginalTexto: {
                type: Type.STRING,
                description: 'Texto original do valor como visto na imagem',
              },
              tipoSugerido: {
                type: Type.STRING,
                description: 'Tipo: "entrada", "saida", "adiantamento", "material" ou "divida"',
              },
              categoria: {
                type: Type.STRING,
                description: 'Categoria financeira (ex: Mão de Obra, Materiais, Alimentação, Transporte, Pix, Adiantamento, Dívida, etc.)',
              },
              formaPagamento: {
                type: Type.STRING,
                description: 'Forma de pagamento (Pix, Dinheiro, Cartão, Transferência, Boleto, etc.)',
              },
              pessoaSugerida: {
                type: Type.STRING,
                description: 'Pessoa relacionada a esta linha',
              },
              confianca: {
                type: Type.STRING,
                description: '"alta" ou "baixa"',
              },
              loja: {
                type: Type.STRING,
                description: 'Nome da loja ou fornecedor se for material',
              },
            },
            required: ['descricao', 'valorCentavos', 'tipoSugerido'],
          },
        },
      },
      required: ['tipoDocumento', 'linhas'],
    };

    let response: any;
    try {
      console.log(`Iniciando extração com Gemini (com Schema e System Prompt otimizado)`);
      response = await ai.models.generateContent({
        model: 'gemini-2.5-flash',
        contents: [
          {
            role: 'user',
            parts: [imagePart, textPart]
          }
        ],
        config: {
          systemInstruction: systemPrompt,
          responseMimeType: 'application/json',
          responseSchema: schemaConfig,
          temperature: 0.1,
        },
      });
    } catch (modelErr: any) {
      console.warn(`Tentativa com schema falhou, tentando chamada padrão...`, modelErr);
      response = await ai.models.generateContent({
        model: 'gemini-2.5-flash',
        contents: [
          {
            role: 'user',
            parts: [imagePart, textPart]
          }
        ],
        config: {
          systemInstruction: systemPrompt,
          responseMimeType: 'application/json',
          temperature: 0.1,
        },
      });
    }

    if (!response || !response.text) {
      throw new Error(`Falha ao processar a imagem com a IA.`);
    }

    let responseText = response.text || '{}';
    responseText = responseText.replace(/```json\s*/gi, '').replace(/```\s*$/gi, '').trim();

    let parsedData;
    try {
      parsedData = JSON.parse(responseText);
    } catch {
      const firstBrace = responseText.indexOf('{');
      const lastBrace = responseText.lastIndexOf('}');
      if (firstBrace !== -1 && lastBrace !== -1 && lastBrace > firstBrace) {
        try {
          parsedData = JSON.parse(responseText.substring(firstBrace, lastBrace + 1));
        } catch {
          console.error('Failed to parse Gemini output:', responseText);
          return res.status(500).json({
            success: false,
            error: 'Erro ao interpretar a resposta da IA. O formato recebido não é um JSON válido.',
            raw: responseText.slice(0, 300),
          });
        }
      } else {
        console.error('Failed to parse Gemini output:', responseText);
        return res.status(500).json({
          success: false,
          error: 'Erro ao interpretar a resposta da IA como JSON.',
          raw: responseText.slice(0, 300),
        });
      }
    }

    if (!parsedData.linhas) {
      parsedData.linhas = [];
    }
    if (!parsedData.todasPessoasIdentificadas) {
      parsedData.todasPessoasIdentificadas = [];
    }

    parsedData.totalEscritoNaAnotacaoCentavos = Math.round(Number(parsedData.totalEscritoNaAnotacaoCentavos) || 0);

    parsedData.linhas = parsedData.linhas.map((l: any) => ({
      ...l,
      quantidade: Number(l.quantidade) || 1,
      valorCentavos: Math.round(Number(l.valorCentavos) || 0),
      valorUnitarioCentavos: l.valorUnitarioCentavos ? Math.round(Number(l.valorUnitarioCentavos)) : undefined,
    }));

    return res.json({
      success: true,
      data: parsedData,
    });
  } catch (error: unknown) {
    const err = error as { message?: string; stack?: string };
    console.error('Erro na extração Gemini:', err);
    return res.status(500).json({
      success: false,
      error: err.message || 'Erro inesperado ao processar a imagem com o Gemini.',
    });
  }
});

// Setup Vite middlewares in development or static serving in production
async function startServer() {
  const isDev = process.env.NODE_ENV !== 'production';

  if (isDev) {
    const { createServer: createViteServer } = await import('vite');
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: 'spa',
    });
    app.use(vite.middlewares);
  } else {
    const distPath = path.resolve(__dirname, 'dist');
    app.use(express.static(distPath));
    app.get('*', (_req, res) => {
      res.sendFile(path.resolve(distPath, 'index.html'));
    });
  }

  app.listen(Number(PORT), '0.0.0.0', () => {
    console.log(`🚀 AcertoFácil servidor rodando em http://0.0.0.0:${PORT}`);
  });
}

startServer();
